# Copy to terraform.tfvars and edit. terraform.tfvars is git-ignored.
region = "eu-west-1"

# Public hostname; Terraform requests an ACM certificate for it.
domain_name = "lmgate.nairvarun.com"

# Who can reach the Kubernetes API. The default is open to the internet (callers still need AWS
# credentials). Narrow it if you have a stable address, e.g. ["203.0.113.10/32"]; behind CGNAT,
# leave it open or reach the API from a fixed-IP host such as a bastion.
# api_public_access_cidrs = ["0.0.0.0/0"]

# Extra tags on every resource (Project, Environment, ManagedBy and Repository are always set).
# environment = "dev"
# tags        = { Owner = "varun", CostCenter = "learning" }

# admin_principal_arns = ["arn:aws:iam::123456789012:role/Admin"]
